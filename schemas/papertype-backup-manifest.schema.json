{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://papertype.local/schema/backup-manifest-v1.json",
  "title": "PaperType Backup Manifest v1",
  "description": "Unknown top-level fields are allowed so that a newer app can add fields without making older apps reject the backup (forward compatibility). Validators must enable format assertion (e.g. ajv-formats) for date-time to be checked.",
  "type": "object",
  "required": [
    "backupFormatVersion",
    "createdAt",
    "noteCount",
    "attachmentCount",
    "notes"
  ],
  "properties": {
    "backupFormatVersion": {
      "const": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "appVersion": {
      "type": "string"
    },
    "noteCount": {
      "type": "integer",
      "minimum": 0
    },
    "attachmentCount": {
      "type": "integer",
      "minimum": 0
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "description": "Fixed relative location inside the ZIP. The pattern rules out absolute paths, backslashes and '..' segments.",
            "type": "string",
            "pattern": "^notes/[A-Za-z0-9-]+\\.json$"
          },
          "sha256": {
            "description": "Lowercase hex SHA-256 of the exact file bytes stored at path.",
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^attachments/[A-Za-z0-9-]+\\.[A-Za-z0-9]{1,8}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
