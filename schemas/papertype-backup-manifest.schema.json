{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://papertype.local/schema/backup-manifest-v1.json",
  "title": "PaperType Backup Manifest v1",
  "type": "object",
  "required": [
    "backupFormatVersion",
    "createdAt",
    "noteCount",
    "attachmentCount",
    "notes"
  ],
  "properties": {
    "backupFormatVersion": {
      "const": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "appVersion": {
      "type": "string"
    },
    "noteCount": {
      "type": "integer",
      "minimum": 0
    },
    "attachmentCount": {
      "type": "integer",
      "minimum": 0
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
