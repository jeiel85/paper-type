{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://papertype.local/schema/note-v1.json",
  "title": "PaperType Note v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "createdAt",
    "updatedAt",
    "text",
    "paperPresetId",
    "inkPresetId",
    "writerSettings"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "title": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "text": {
      "type": "string"
    },
    "paperPresetId": {
      "type": "string"
    },
    "inkPresetId": {
      "type": "string"
    },
    "writerSettings": {
      "type": "object",
      "required": [
        "typeSize",
        "marginMode",
        "correctionMode",
        "seedAlgorithmVersion"
      ],
      "properties": {
        "typeSize": {
          "enum": [
            "small",
            "regular",
            "large",
            "larger"
          ]
        },
        "marginMode": {
          "enum": [
            "wide",
            "narrow"
          ]
        },
        "correctionMode": {
          "enum": [
            "clean",
            "typewriter"
          ]
        },
        "seedAlgorithmVersion": {
          "type": "integer",
          "minimum": 1
        },
        "inkSeed": {
          "description": "Seed source for deterministic ink (see docs/05 §2). Set to the note id at creation and kept when a note is copied under a new id, so a copy looks the same. Falls back to `id` when absent.",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "correctionMarks": {
      "description": "Typewriter correction marks (Phase 2 feature). Provisional until the backup schema freeze in Phase 2.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "at",
          "originalText",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "strike"
            ]
          },
          "at": {
            "description": "UTF-16 offset in the current `text` where the struck-out text is shown.",
            "type": "integer",
            "minimum": 0
          },
          "originalText": {
            "type": "string",
            "minLength": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": true
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "image"
            ]
          },
          "fileName": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          }
        }
      }
    },
    "platformExtensions": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "Validators must enable format assertion (e.g. ajv-formats) for date-time to be checked. Text offsets are UTF-16 code unit offsets into `text` (same unit as JavaScript and Kotlin strings)."
}
